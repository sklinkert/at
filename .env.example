# Configuration for cmd/backtesting (read from the environment via github.com/lfritz/env).
# Copy the values you need onto the command line or export them before running.
# Shown values are the built-in defaults.

# Enable verbose debug logging.
DEBUG=false

# Print gathered performance data as CSV.
PERFORMANCE_DATA=false

# Comma-separated histdata.com CSV files to import instead of reading from the DB.
# Leave empty to read prices from PRICE_DB_FILE.
IMPORT_HISTDATA_CSV_FILES=

# Price source for the backtest: LOCAL_DB (SQLite) or COINBASE.
PRICE_SOURCE=LOCAL_DB

# SQLite DB file holding OHLC price data (used when PRICE_SOURCE=LOCAL_DB).
PRICE_DB_FILE=/data/EURUSD/db

# Instrument to trade (e.g. EURUSD, BTC-USD, CS.D.EURUSD.MINI.IP).
INSTRUMENT=CS.D.EURUSD.MINI.IP

# Broker backend.
BROKER=backtest

# Strategy to run: rsi, rsiadx, sma10, stochrsi, doji, engulfing, harami,
# lowcandle, scalper, heikinashi.
STRATEGY=rsi

# Duration of a single OHLC candle (Go duration, e.g. 1m, 60m, 24h).
CANDLE_DURATION=60m

# Backtest time range.
YEAR_FROM=1970
MONTH_FROM=1
YEAR_TO=2022
MONTH_TO=12
